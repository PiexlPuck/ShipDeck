# ShipDeck Dashboard Configuration Example env file

# Port to listen on (internal and external)
PORT=8765

# Authentication strategy.
# Set to 'header' to enable proxy-based header protection (e.g. Authentik, Authelia)
# Set to 'none' for unrestricted preview mode
AUTH_TYPE=none

# GitHub credentials for cloning and pulling from private git repositories.
# Keep username/token empty if only deploying public repositories.
GITHUB_USERNAME=
GITHUB_TOKEN=
